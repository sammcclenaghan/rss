<%# One row on the Manage Feeds page: feed summary + an inline edit form
    (revealed via <details>) and a delete button. `feed` is a ConfiguredFeed. %>
<% groups = local_assigns[:groups] || [] %>
<% current_group = feed.tags.first.to_s.delete_prefix("#") %>
<details class="group">
  <summary class="list-none flex cursor-pointer items-center gap-3 px-5 py-3 hover:bg-muted/60">
    <span class="size-2.5 shrink-0 rounded-full" style="background-color: <%= legible_feed_color(feed.color) %>"></span>
    <span class="min-w-0 flex-1">
      <span class="flex items-center gap-1.5">
        <span class="truncate font-medium"><%= feed.name %></span>
        <% if feed.hidden %><%= icon "eye-off", class: "size-3.5 shrink-0 text-muted-foreground" %><% end %>
      </span>
      <span class="block truncate text-xs text-muted-foreground"><%= feed.url %></span>
    </span>
    <%= link_to feed.url, target: "_blank", rel: "noopener", class: "shrink-0 rounded-full p-2 text-muted-foreground hover:bg-accent hover:text-accent-foreground", title: "Open feed" do %>
      <%= icon "external-link", class: "size-4" %>
    <% end %>
    <span class="shrink-0 rounded-full p-2 text-muted-foreground" title="Edit"><%= icon "pencil", class: "size-4" %></span>
  </summary>

  <div class="bg-muted/40 px-5 pb-5 pt-2">
    <% edit_form_id = "edit-feed-#{feed.feed.id}" %>
    <%= form_with url: feed_path(feed.feed.id), method: :patch, id: edit_form_id, class: "grid gap-4 sm:grid-cols-2" do %>
      <label class="block">
        <span class="mb-1 block text-xs font-medium text-muted-foreground">Name</span>
        <input type="text" name="name" autocomplete="off" value="<%= feed.name %>"
               class="w-full rounded-xl border border-input bg-background px-3.5 py-2 text-sm">
      </label>
      <label class="block">
        <span class="mb-1 block text-xs font-medium text-muted-foreground">Group</span>
        <input type="text" name="tag" value="<%= current_group %>" list="group-options" autocomplete="off"
               class="w-full rounded-xl border border-input bg-background px-3.5 py-2 text-sm">
      </label>
      <div>
        <span class="mb-1 block text-xs font-medium text-muted-foreground">Colour</span>
        <%= render "feeds/color_field", value: feed.color %>
      </div>
      <label class="flex items-center gap-2 text-sm">
        <%= tag.input type: "checkbox", name: "hidden", value: "1", checked: feed.hidden, autocomplete: "off", class: "rounded border-input" %>
        <span>Hide from the default view</span>
      </label>
      <label class="block sm:col-span-2">
        <span class="mb-1 block text-xs font-medium text-muted-foreground">Library proxy host <span class="font-normal">(optional)</span></span>
        <input type="text" name="proxy" value="<%= feed.proxy %>" placeholder="ezproxy.library.uvic.ca" autocomplete="off"
               class="w-full rounded-xl border border-input bg-background px-3.5 py-2 text-sm placeholder:text-muted-foreground">
      </label>
    <% end %>

    <%# Delete is its own form — kept OUTSIDE the edit form above so its
        _method=delete can't leak into the edit submit (nested forms are
        invalid HTML and merge). Save targets the edit form via `form:`. %>
    <div class="flex items-center justify-between pt-4">
      <%= button_to feed_path(feed.feed.id), method: :delete,
            data: { turbo_confirm: "Remove “#{feed.name}” and all its posts?" },
            class: "inline-flex cursor-pointer items-center gap-1.5 rounded-lg bg-destructive/10 px-4 py-2 text-sm font-medium text-destructive hover:bg-destructive/20" do %>
        <%= icon "trash-2", class: "size-4" %> Remove
      <% end %>
      <%= submit_tag "Save", form: edit_form_id, class: "cursor-pointer rounded-lg bg-primary px-5 py-2 text-sm font-medium text-primary-foreground hover:opacity-90" %>
    </div>
  </div>
</details>
