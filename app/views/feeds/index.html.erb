<% content_for :title, "Manage feeds" %>
<% existing_groups = @feeds.flat_map(&:tags).map { |t| t.delete_prefix("#") }.reject(&:blank?).uniq.sort %>

<div class="min-h-full">
  <div class="mx-auto max-w-3xl px-4 py-6 md:px-6 md:py-8">

    <%# Header %>
    <div class="mb-6 flex items-center justify-between gap-4">
      <div class="flex min-w-0 items-center gap-3">
        <%= link_to root_path, class: "shrink-0 rounded-full bg-muted p-2 text-muted-foreground hover:bg-accent hover:text-accent-foreground", title: "Back to reader" do %>
          <%= icon "arrow-left", class: "size-4" %>
        <% end %>
        <h1 class="truncate text-xl font-bold tracking-tight md:text-2xl">Manage feeds</h1>
      </div>
      <div class="flex shrink-0 items-center gap-2">
        <%= link_to feeds_export_path, class: "inline-flex items-center gap-1.5 rounded-lg bg-muted px-4 py-2 text-sm font-medium hover:bg-accent hover:text-accent-foreground" do %>
          <%= icon "download", class: "size-4" %>
          <span class="hidden sm:inline">Export</span>
        <% end %>
        <details class="relative">
          <summary class="list-none inline-flex cursor-pointer items-center gap-1.5 rounded-lg bg-muted px-4 py-2 text-sm font-medium hover:bg-accent hover:text-accent-foreground">
            <%= icon "upload", class: "size-4" %>
            <span class="hidden sm:inline">Import</span>
          </summary>
          <%= form_with url: feeds_import_path, method: :post, multipart: true,
                class: "absolute right-0 z-30 mt-2 w-72 space-y-2 rounded-2xl bg-popover p-4 text-popover-foreground shadow-xl" do %>
            <p class="text-sm text-muted-foreground">Import feeds from an OPML file.</p>
            <input type="file" name="file" accept=".opml,.xml,text/xml,application/xml" autocomplete="off" required
                   class="block w-full text-sm file:mr-2 file:rounded-lg file:border-0 file:bg-muted file:px-3 file:py-1.5 file:text-sm file:font-medium file:text-foreground">
            <%= submit_tag "Import", class: "w-full cursor-pointer rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:opacity-90" %>
          <% end %>
        </details>
      </div>
    </div>

    <%# Add feed %>
    <%= form_with url: feeds_path, method: :post, class: "mb-8 rounded-3xl bg-card p-5 shadow-sm" do %>
      <h2 class="mb-4 flex items-center gap-2 text-sm font-semibold"><%= icon "plus", class: "size-4" %> Add a feed</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="block sm:col-span-2">
          <span class="mb-1 block text-xs font-medium text-muted-foreground">Feed URL</span>
          <input type="url" name="url" required placeholder="https://example.com/feed.xml" autocomplete="url"
                 class="w-full rounded-xl border border-input bg-background px-3.5 py-2 text-sm placeholder:text-muted-foreground">
        </label>
        <label class="block">
          <span class="mb-1 block text-xs font-medium text-muted-foreground">Name <span class="font-normal">(optional — auto-detected)</span></span>
          <input type="text" name="name" placeholder="The Verge" autocomplete="off"
                 class="w-full rounded-xl border border-input bg-background px-3.5 py-2 text-sm placeholder:text-muted-foreground">
        </label>
        <label class="block">
          <span class="mb-1 block text-xs font-medium text-muted-foreground">Group <span class="font-normal">(optional)</span></span>
          <input type="text" name="tag" list="group-options" placeholder="news" autocomplete="off"
                 class="w-full rounded-xl border border-input bg-background px-3.5 py-2 text-sm placeholder:text-muted-foreground">
        </label>
        <div>
          <span class="mb-1 block text-xs font-medium text-muted-foreground">Colour <span class="font-normal">(optional)</span></span>
          <%= render "feeds/color_field" %>
        </div>
        <label class="flex items-center gap-2 text-sm">
          <input type="checkbox" name="hidden" value="1" autocomplete="off" class="rounded border-input">
          <span>Hide from the default view</span>
        </label>
        <label class="block sm:col-span-2">
          <span class="mb-1 block text-xs font-medium text-muted-foreground">Library proxy host <span class="font-normal">(optional)</span></span>
          <input type="text" name="proxy" placeholder="ezproxy.library.uvic.ca" autocomplete="off"
                 class="w-full rounded-xl border border-input bg-background px-3.5 py-2 text-sm placeholder:text-muted-foreground">
          <span class="mt-1 block text-xs text-muted-foreground">Opens this feed's articles through your library's EZProxy so you read them with institutional access. Leave blank for normal links.</span>
        </label>
      </div>
      <div class="mt-4 flex justify-end">
        <%= submit_tag "Add feed", class: "cursor-pointer rounded-lg bg-primary px-5 py-2 text-sm font-medium text-primary-foreground hover:opacity-90" %>
      </div>
    <% end %>

    <datalist id="group-options">
      <% existing_groups.each { |g| %><option value="<%= g %>"></option><% } %>
    </datalist>

    <%# Feed list, grouped by folder %>
    <% if @feeds.none? %>
      <p class="py-10 text-center text-sm text-muted-foreground">No feeds yet. Add one above.</p>
    <% else %>
      <div class="space-y-6">
        <% grouped_feeds(@feeds).each do |group| %>
          <section>
            <h2 class="mb-2 flex items-center gap-2 px-2 text-xs font-semibold uppercase tracking-wide text-muted-foreground">
              <%= icon "folder", class: "size-3.5" %><%= group[:name].capitalize %>
              <span class="font-normal normal-case">(<%= group[:feeds].size %>)</span>
            </h2>
            <div class="overflow-hidden rounded-3xl bg-card shadow-sm divide-y divide-border">
              <% group[:feeds].each do |feed| %>
                <%= render "feeds/manage_feed", feed: feed, groups: existing_groups %>
              <% end %>
            </div>
          </section>
        <% end %>
      </div>
    <% end %>

  </div>
</div>
