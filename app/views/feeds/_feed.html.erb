<% feed_cfg = feed %>
<% counts = local_assigns[:unread_counts] || {} %>
<% unread_count = counts.fetch(feed_cfg.feed.id, 0).to_i %>
<% active = defined?(@selected_feed) && @selected_feed.present? && @selected_feed == feed_cfg.url %>
<div class="py-px">
  <%= link_to feed_posts_path(feed_cfg.encoded_url),
        class: "group flex items-center gap-2 rounded-lg py-1.5 pl-8 pr-3 text-sm #{active ? 'bg-sidebar-accent text-sidebar-accent-foreground' : 'text-sidebar-foreground hover:bg-sidebar-accent/60 hover:text-sidebar-accent-foreground'}" do %>
    <span class="size-2 shrink-0 rounded-full" style="background-color: <%= legible_feed_color(feed_cfg.color) %>"></span>
    <span class="min-w-0 flex-1 truncate"><%= feed_cfg.name %></span>
    <% if feed_cfg.hidden %>
      <span title="Posts hidden by default" class="flex shrink-0"><%= icon "eye-off", class: "size-3.5 text-muted-foreground" %></span>
    <% end %>
    <span data-counts-target="feed" data-feed-id="<%= feed_cfg.feed.id %>"
          class="shrink-0 text-xs text-muted-foreground tabular-nums <%= "hidden" if unread_count == 0 %>"><%= unread_count %></span>
  <% end %>
  <%# A feed past its refresh interval is waiting on (or in) a background
      fetch; the sidebar's refresh-status poller removes this row when the
      fetch lands. %>
  <% if feed_cfg.outdated? %>
    <div data-refresh-status-target="status" data-feed-id="<%= feed_cfg.feed.id %>"
         class="flex items-center gap-2 py-1 pl-8 text-xs text-muted-foreground">
      <%= icon "refresh-cw", class: "size-3.5 animate-spin" %>
      <span>Refreshing…</span>
    </div>
  <% end %>
</div>
