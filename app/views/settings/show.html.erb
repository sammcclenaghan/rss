<% content_for :title, "Settings" %>

<div class="min-h-full">
  <div class="mx-auto max-w-3xl px-4 py-6 md:px-6 md:py-8">

    <%# Header %>
    <div class="mb-8 flex items-center gap-3">
      <%= link_to root_path, class: "shrink-0 rounded-full bg-muted p-2 text-muted-foreground hover:bg-accent hover:text-accent-foreground", title: "Back to reader" do %>
        <%= icon "arrow-left", class: "size-4" %>
      <% end %>
      <h1 class="text-xl font-bold tracking-tight md:text-2xl">Settings</h1>
    </div>

    <%# Feed behaviour (read-only) %>
    <section class="mb-10">
      <h2 class="mb-1 flex items-center gap-2 text-sm font-semibold"><%= icon "settings", class: "size-4" %> Feed behaviour</h2>
      <p class="mb-3 text-xs text-muted-foreground">Configured via environment variables, set at deploy time. The app follows your device's light or dark appearance.</p>
      <dl class="rounded-3xl bg-card text-sm shadow-sm divide-y divide-border">
        <% [
             [ "Feeds configured", @feed_count.to_s, nil ],
             [ "Refresh interval", "#{@rss.feed_update_frequency / 60} min", "FEED_UPDATE_FREQUENCY_MINUTES" ],
             [ "Fetch thumbnails", @rss.load_post_thumbnails ? "On" : "Off", "LOAD_POST_THUMBNAILS" ],
             [ "Prune posts after", @rss.prune_posts_after_days ? "#{@rss.prune_posts_after_days} days" : "Never", "PRUNE_POSTS_AFTER_DAYS" ],
             [ "Posts per page", @rss.posts_per_page.to_s, "POSTS_PER_PAGE" ]
           ].each do |label, value, env| %>
          <div class="flex items-center justify-between gap-4 px-5 py-3">
            <dt class="text-muted-foreground">
              <%= label %>
              <% if env %><code class="ml-1 text-xs opacity-60"><%= env %></code><% end %>
            </dt>
            <dd class="font-medium tabular-nums"><%= value %></dd>
          </div>
        <% end %>
      </dl>
    </section>

    <%# Links %>
    <section>
      <h2 class="mb-3 flex items-center gap-2 text-sm font-semibold"><%= icon "rss", class: "size-4" %> Manage</h2>
      <div class="overflow-hidden rounded-3xl bg-card shadow-sm divide-y divide-border">
        <%= link_to feeds_path, class: "flex items-center gap-3 px-5 py-3.5 text-sm hover:bg-muted/60" do %>
          <%= icon "rss", class: "size-4 text-muted-foreground" %>
          <span class="flex-1">Manage feeds</span>
          <%= icon "chevron-right", class: "size-4 text-muted-foreground" %>
        <% end %>
        <a href="/jobs" class="flex items-center gap-3 px-5 py-3.5 text-sm hover:bg-muted/60">
          <%= icon "refresh-cw", class: "size-4 text-muted-foreground" %>
          <span class="flex-1">Background jobs dashboard</span>
          <%= icon "external-link", class: "size-4 text-muted-foreground" %>
        </a>
      </div>
    </section>

  </div>
</div>
