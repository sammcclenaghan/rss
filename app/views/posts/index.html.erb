<div class="md:flex h-full min-h-0"
     data-controller="toggle-class keyboard counts"
     data-toggle-class-toggle-class="sidebar-open"
     data-action="post-read:changed->counts#update">

  <%# Sidebar — only rendered on full-page requests; turbo-frame requests
      (search, pagination) update just the #posts frame and skip sidebar data. %>
  <% if @sidebar_feeds %>
    <%= render "posts/sidebar" %>
  <% end %>

  <%# Main content %>
  <div class="min-w-0 flex flex-col md:flex-1 md:h-full md:overflow-hidden">

    <header class="px-4 md:px-8 pt-4 pb-2 md:pt-6">
      <div class="flex w-full items-center justify-between gap-3">
        <div class="flex min-w-0 items-center gap-1.5">
          <% if @sidebar_feeds %>
            <button type="button" data-action="click->toggle-class#toggle" aria-label="Open menu"
                    class="-ml-2 shrink-0 rounded-full p-2 text-muted-foreground hover:bg-muted md:hidden cursor-pointer">
              <%= icon "menu", class: "size-5" %>
            </button>
          <% end %>
          <h1 class="truncate text-xl font-bold tracking-tight md:text-2xl"><%= current_view_title %></h1>
        </div>

        <%= button_to posts_bulk_reading_path,
              params: { tag: @tag, feed: @selected_feed, query: @query },
              data: { keyboard_target: "markAll" },
              class: "shrink-0 inline-flex items-center gap-1.5 rounded-lg bg-muted px-4 py-2 text-sm font-medium text-foreground hover:bg-accent cursor-pointer" do %>
          <%= icon "check-check", class: "size-4" %>
          <span class="hidden sm:inline">Mark all as read</span>
        <% end %>
      </div>
    </header>

    <div class="md:flex-1 md:overflow-auto px-4 md:px-8 pb-8">
      <%= turbo_frame_tag "posts", class: "block w-full" do %>

        <%# Filter tabs %>
        <div class="mb-3 mt-2">
          <div class="inline-flex rounded-lg bg-muted p-1 text-sm">
            <%= link_to "All", filter_path(:all), class: content_tab_class(:all) %>
            <%= link_to "Unread", filter_path(:unread),
                  data: { keyboard_target: (@unread_only ? nil : "unreadToggle") },
                  class: content_tab_class(:unread) %>
            <%= link_to "Starred", filter_path(:starred), class: content_tab_class(:starred) %>
          </div>
          <%# Keep the unread toggle reachable from the keyboard when unread is on. %>
          <% if @unread_only %>
            <%= link_to "", filter_path(:all), data: { keyboard_target: "unreadToggle" }, class: "hidden" %>
          <% end %>
        </div>

        <%# Posts %>
        <% if @posts.empty? %>
          <div class="flex flex-col items-center gap-3 py-20 text-muted-foreground">
            <%= icon "inbox", class: "size-8" %>
            <p class="text-sm"><%= @starred_only ? "No starred posts." : @unread_only ? "You're all caught up." : "No posts yet." %></p>
          </div>
        <% end %>
        <div class="-mx-4 space-y-px">
          <% @posts.each do |post| %>
            <%= render "posts/post", post: post %>
          <% end %>
        </div>

        <%# Pagination %>
        <div class="flex py-4">
          <% if @page > 1 %>
            <%= link_to url_for(page: @page - 1, query: @query, unread: @unread_only ? "1" : nil, starred: @starred_only ? "1" : nil),
                data: { turbo_frame: "posts" },
                class: "inline-flex items-center gap-1.5 rounded-lg bg-muted px-4 py-2 text-sm font-medium text-foreground hover:bg-accent" do %>
              <%= icon "arrow-left", class: "size-4" %> Previous
            <% end %>
          <% end %>
          <% if @posts.length == 100 %>
            <%= link_to url_for(page: @page + 1, query: @query, unread: @unread_only ? "1" : nil, starred: @starred_only ? "1" : nil),
                data: { turbo_frame: "posts" },
                class: "ml-auto inline-flex items-center gap-1.5 rounded-lg bg-muted px-4 py-2 text-sm font-medium text-foreground hover:bg-accent" do %>
              Next <%= icon "arrow-right", class: "size-4" %>
            <% end %>
          <% end %>
        </div>

      <% end %>
    </div>
  </div>

  <%= render "posts/keyboard_help" %>
</div>
